# Dependencies
node_modules

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.local
*.log

# Build metadata and test output
*.tsbuildinfo
coverage/

# DEV-ONLY ESCAPP SETTINGS: never commit this.
#
# config.mjs holds your escape room's real API endpoint (and is the only place
# a credential could end up). Copy config.example.mjs to create it. In
# production the Escapp server injects these settings itself, so the file is
# not needed for deployment.
config.mjs
.env
.env.*

# Stale output from before the build moved to docs/
dist

# NOTE ON docs/
#
# docs/ is BUILD OUTPUT and is deliberately committed, because GitHub Pages
# serves the site from /docs on the default branch. Regenerate it with
# `npm run build` and commit the result alongside any source change, or the
# published page goes stale.
#
# The written guides are in guides/, not here: Vite empties its output
# directory on every build.
